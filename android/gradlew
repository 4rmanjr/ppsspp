#!/bin/sh
# Gradle wrapper generated by PPSSPP LAN Sync
APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P ) || exit
GRADLE_HOME="${APP_HOME}/gradle/wrapper"

# Use cached gradle if available
for dir in "$HOME/.gradle/wrapper/dists/"*; do
  if [ -d "$dir" ]; then
    for jar in "$dir"/*/"gradle-wrapper.jar"; do
      if [ -f "$jar" ]; then
        exec java -classpath "$jar" org.gradle.wrapper.GradleWrapperMain "$@"
      fi
    done
  fi
done

# Fallback: try system gradle
exec gradle "$@"
